{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VisionScope",
  "version": "0.1.0",
  "identifier": "com.blendviewer.visionscope",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VisionScope",
        "width": 1600,
        "height": 900,
        "minWidth": 600,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "glb",
          "gltf",
          "fbx",
          "obj",
          "stl",
          "3ds",
          "3dm",
          "3mf",
          "dae",
          "ifc",
          "dwg",
          "dxf",
          "ply",
          "pcd",
          "las",
          "ktx2",
          "basis",
          "tif",
          "tiff",
          "png",
          "jpg",
          "jpeg",
          "webp",
          "gif",
          "bmp",
          "svg",
          "pdf",
          "pptx",
          "ppt",
          "doc",
          "txt",
          "md",
          "csv",
          "tsv",
          "xlsx",
          "xls",
          "ods"
        ],
        "name": "VisionScope Document",
        "description": "Open with VisionScope",
        "role": "Viewer"
      }
    ]
  }
}
