# VisionScope Desktop — Windows release (optional)

# Profile default when not passed on CLI: dev | direct
# WINDOWS_PROFILE=direct

# Rust target triple (optional). Examples:
# WINDOWS_BUILD_TARGET=x86_64-pc-windows-msvc
# WINDOWS_BUILD_TARGET=aarch64-pc-windows-msvc

# 本地代理（Tauri 下载 NSIS 必须 SOCKS；Clash 常见 socks 端口 7891，mixed 端口 7897）
# WINDOWS_PROXY=socks5://127.0.0.1:7897
# WINDOWS_SIGN_COMMAND=signtool sign /fd sha256 /tr http://timestamp.digicert.com /td sha256 /a

# SignPath (optional — configure after approval)
# SIGNPATH_ORGANIZATION_ID=
# SIGNPATH_PROJECT_SLUG=
# SIGNPATH_SIGNING_POLICY_SLUG=release-signing
# SIGNPATH_API_TOKEN=   # GitHub Actions secret only — do not commit
