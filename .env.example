# 复制为 .env 并填写敏感字段（APPLE_PASSWORD 等）
# 用法: pnpm release:macos -- dev|direct|appstore

# ── 开发版 (dev) ──
# Team ID 填证书 OU 字段（Xcode → Membership 页），不是证书名括号里的个人 ID
MACOS_DEV_TEAM=YOUR_TEAM_ID
MACOS_DEV_SIGNING_IDENTITY="Apple Development: your@email.com (YOUR_DEV_TEAM_ID)"
MACOS_DEV_CODE_SIGN_IDENTITY="Apple Development"
MACOS_DEV_ENTITLEMENTS=src-tauri/Entitlements.direct.plist
MACOS_DEV_QL_ENTITLEMENTS=quicklook/VisionScopeQuickLook/VisionScopeQuickLook.entitlements

# ── 离线版 (direct) ──
MACOS_DIRECT_TEAM=YOUR_RELEASE_TEAM_ID
MACOS_DIRECT_SIGNING_IDENTITY="Developer ID Application: Your Name (YOUR_RELEASE_TEAM_ID)"
MACOS_DIRECT_CODE_SIGN_IDENTITY="Developer ID Application"
MACOS_DIRECT_ENTITLEMENTS=src-tauri/Entitlements.direct.plist
MACOS_DIRECT_QL_ENTITLEMENTS=quicklook/VisionScopeQuickLook/VisionScopeQuickLook.entitlements
MACOS_DIRECT_APPLE_ID=your@email.com
MACOS_DIRECT_APPLE_PASSWORD=xxxx-xxxx-xxxx-xxxx
MACOS_DIRECT_APPLE_API_ISSUER=
MACOS_DIRECT_APPLE_API_KEY=
MACOS_DIRECT_APPLE_API_KEY_PATH=

# ── App Store 版 (appstore) ──
MACOS_APPSTORE_TEAM=YOUR_RELEASE_TEAM_ID
MACOS_APPSTORE_SIGNING_IDENTITY="Apple Distribution: Your Name (YOUR_RELEASE_TEAM_ID)"
MACOS_APPSTORE_CODE_SIGN_IDENTITY="Apple Distribution"
MACOS_APPSTORE_ENTITLEMENTS=src-tauri/Entitlements.appstore.plist
MACOS_APPSTORE_QL_ENTITLEMENTS=quicklook/VisionScopeQuickLook/VisionScopeQuickLook.entitlements
MACOS_APPSTORE_PROVISIONPROFILE=path/to/VisionScope.provisionprofile
MACOS_APPSTORE_APPLE_API_ISSUER=
MACOS_APPSTORE_APPLE_API_KEY=
MACOS_APPSTORE_APPLE_API_KEY_PATH=
